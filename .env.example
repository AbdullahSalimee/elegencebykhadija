# Supabase — create a project at supabase.com, then Project Settings > API.
# NEXT_PUBLIC_SUPABASE_URL is safe to expose; SUPABASE_SERVICE_ROLE_KEY is not —
# it's only ever read server-side (lib/supabase/server.js), never sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin console (/admin) — REQUIRED. Without both of these the console and
# every admin API returns an error, which is the safe failure: they guard the
# product catalogue and every customer's contact details.
#
# ADMIN_PASSWORD is the single shared password for the shop owner.
# ADMIN_SESSION_SECRET signs the admin session cookie (min 16 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing the secret immediately signs out every admin browser.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# JazzCash Online Payment Gateway (apply for merchant account first)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=

# Easypaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# WhatsApp ordering number, international format, no plus/spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Email (order confirmation + status-change follow-ups) — create a free account
# at resend.com, verify a sending domain, then paste the API key here. Leave
# blank and the app just skips sending (logs to console) — never blocks an order.
RESEND_API_KEY=
EMAIL_FROM="Elegance by Khadija <orders@elegancebykhadija.pk>"

# Absolute site URL, used in email links (relative links don't work in inboxes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail sending (no domain needed). Enable 2-Step Verification, then create an
# App Password at myaccount.google.com > Security > App passwords.
# When set, these take priority over RESEND_API_KEY.
GMAIL_USER=
GMAIL_APP_PASSWORD=
